<?xml version="1.0" ?>
<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment length="0"
                ticks_per_second="10"
                random_seed="$$seed$$" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <buzz_controller_footbot id="fgc">
      <actuators>
        <differential_steering implementation="default" />
        <range_and_bearing           implementation="default" />
        <footbot_gripper                implementation="default" />
        <footbot_turret                   implementation="default" />
      </actuators>
      <sensors>
        <range_and_bearing implementation="medium" medium="rab" show_rays="false" />
        <footbot_proximity implementation = "default" show_rays = "true" />
      </sensors>
      <params bytecode_file = "build/argos/collectiveRlTransport.bo"
                         debug_file = "build/argos/collectiveRlTransport.bdb" />
    </buzz_controller_footbot>

  </controllers>

  <!-- ****************** -->
  <!-- * Loop functions * -->
  <!-- ****************** -->
  <!-- Setting proximity_range = 0 will keep it at default -->
  <loop_functions library="build/argos/libcollectiveRlTransport"
                  label="collective_rl_transport"
                  data_file = "data.csv"
                  num_robots = "$$num_robots$$"
                  max_robot_failures = "$$max_robot_failures$$"
		              latest_failure_time = "$$latest_failure_time$$"
		              chance_failure = "$$chance_failure$$"
                  goal = "$$goal_x$$, 0"
                  threshold = "$$goal_radius$$"
                  threshold_freq = "100"
                  threshold_dec = "0.1"
                  min_threshold = "$$goal_radius$$"
                  num_episodes = "$$num_episodes$$"
                  episode_time = "$$episode_time$$"
                  time_out_reward = "0"
                  goal_reward = "0"
                  pytorch_url = "tcp://localhost:$$pytorch_port$$"
		              alphabet_size = "1"
                  proximity_range = "1"
                  num_obstacles = "$$num_obstacles$$"
                  use_gate = "$$use_gate$$"
                  gate_curriculum = "$$gate_curriculum$$"
                  gate_update_frequency = "50"
                  gate_update_amount = "0.25"
                  gate_minimum = "$$gate_minimum$$"
                  gate_success_threshold = "$$gate_success_threshold$$"
                  gate_success_window = "$$gate_success_window$$"
                  use_base_model = "0"
                  use_prisms = "$$use_prisms$$"
                  random_objs = "$$random_objs$$"
                  test_prism = "$$test_prism$$"
                  cylinder_radius = "$$cylinder_radius$$"
                  object_shape = "$$object_shape$$"
                  rod_length = "$$rod_length$$"
                  rod_width = "$$rod_width$$"
                  obstacle_radius = "$$obstacle_radius$$"
                  obstacle_height = "$$obstacle_height$$"/>


  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="$$arena_x$$, $$arena_y$$, 1" center="0,0,0.5">

    <box id="wall_north" size="$$arena_x$$,0.5,0.5" movable="false">
      <body position="0,$$wall_ns_y$$,0" orientation="0,0,0" />
    </box>
    <box id="wall_south" size="$$arena_x$$,0.5,0.5" movable="false">
      <body position="0,-$$wall_ns_y$$,0" orientation="0,0,0" />
    </box>
    <box id="wall_east" size="0.5,$$arena_y$$,0.5" movable="false">
      <body position="$$wall_ew_x$$,0,0" orientation="0,0,0" />
    </box>
    <box id="wall_west" size="0.5,$$arena_y$$,0.5" movable="false">
      <body position="-$$wall_ew_x$$,0,0" orientation="0,0,0" />
    </box>
  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <range_and_bearing id="rab" />
  </media>

  <!-- ****************** -->
  <!-- * Visualization * -->
  <!-- ****************** -->
  <visualization>
    <!--<qt-opengl>
        <user_functions label="collective_rl_transport_qtuser_functions" />
        <camera>
          <placements>
            <placement index="0" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
            <placement index="1" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
            <placement index="2" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
            <placement index="3" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
            <placement index="4" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
            <placement index="5" position="-0.0949266,-14.2218,39.2676" look_at="-0.0927412,-13.8906,38.324" up="0.00622709,0.943554,0.331159" lens_focal_length="65" />
          </placements>
        </camera>
      </qt-opengl>-->
  </visualization>

</argos-configuration>
